# Platform API credentials
# Optional. GitHub checks work anonymously, but a token helps avoid anonymous rate limits.
GITHUB_TOKEN=

# Required for the active Steam checker.
STEAM_API_KEY=

# Required for the active Twitch checker.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Required for the active Reddit checker.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Required for the active Tumblr checker.
TUMBLR_CONSUMER_KEY=

# Contact form SMTP delivery
# Required for POST /api/contact to send mail. Without these values, the route returns 503.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# Advertising
# Optional. Example format: ca-pub-XXXXXXXXXXXXXXXX.
NEXT_PUBLIC_ADSENSE_CLIENT=
